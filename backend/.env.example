# ================= 应用 =================
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8100
APP_DEBUG=true
# 生产必须改为具体域名，不允许 *
APP_CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8100

# ================= 数据库 =================
# 必须用 asyncmy 异步驱动；用 pymysql 会卡死事件循环
DATABASE_URL=mysql+asyncmy://sbp:sbp_password@127.0.0.1:3306/storyboard_pipeline
# 使用 deploy/compose.dev.yml 时，将上面的端口改为 13306，并保持密码一致。
MYSQL_PASSWORD=sbp_password
MYSQL_ROOT_PASSWORD=replace_with_a_local_random_password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ================= Redis =================
REDIS_URL=redis://127.0.0.1:6379/3
# 使用 deploy/compose.dev.yml 时，将上面的端口改为 16379。
ARQ_QUEUE_NAME=sbp_tasks

# ================= 预算（单位：分）=================
# 总预算 200 元 = 20000 分
BUDGET_TOTAL_CENTS=20000
BUDGET_PER_SHOT_CENTS=300
# 达到该比例告警 / 降级 / 熔断
BUDGET_WARN_RATIO=0.7
BUDGET_DEGRADE_RATIO=0.9
# 单镜头最大抽卡次数
SHOT_MAX_RETRY=6

# ================= 模型供应商 =================
# 火山引擎（即梦）：图像 + 视频
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
VOLC_IMAGE_MODEL=jimeng-3.0
VOLC_VIDEO_MODEL=jimeng-video-3.0-720p
# 阿里云百炼：视觉质检 + LLM（优先用免费 Token 额度）
DASHSCOPE_API_KEY=
DASHSCOPE_VISION_MODEL=qwen-vl-max
DASHSCOPE_LLM_MODEL=qwen-plus
# Vidu：多角色参考图绑定
VIDU_API_KEY=
VIDU_IMAGE_MODEL=viduq2-fast_reference2image
VIDU_VIDEO_MODEL=viduq2-pro_img2video
# 可灵（京东云灵境）：视频降级备选
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_VIDEO_MODEL=kling-v3-std
# 硅基流动：统一 API 配置（图像/视觉/LLM Provider 已接入；视频待后续联调）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_IMAGE_MODEL=Qwen/Qwen-Image-Edit-2509
SILICONFLOW_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
SILICONFLOW_LLM_MODEL=Qwen/Qwen3-32B
SILICONFLOW_VIDEO_MODEL=Wan-AI/Wan2.2-I2V-A14B

# ================= Provider 行为 =================
# 供应商并发闸门（免费档普遍为 1-2）
PROVIDER_MAX_CONCURRENCY=1
PROVIDER_TIMEOUT_S=60
VIDEO_TIMEOUT_S=600
PROVIDER_MAX_BACKOFF_S=30

# ================= 流水线 =================
# 每镜头默认抽卡张数
RENDER_N_PER_SHOT=2
# 质检判定失败时的最大解析重试次数
QC_PARSE_MAX_RETRY=2
# 图像 / 视频降级链（逗号分隔，按序尝试）
IMAGE_PROVIDER_CHAIN=siliconflow,jimeng,vidu
VIDEO_PROVIDER_CHAIN=kling,jimeng
VISION_PROVIDER_CHAIN=siliconflow,dashscope
LLM_PROVIDER_CHAIN=siliconflow,dashscope

# ================= 存储 =================
STORAGE_ROOT=../storage
MAX_UPLOAD_MB=20

# ================= FFmpeg =================
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# ================= 日志 =================
LOG_LEVEL=INFO
LOG_DIR=../logs
