# ============================================================
# 分镜流水线 · Git 忽略规则
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
*.egg
.Python
pip-log.txt
pip-delete-this-directory.txt

# 虚拟环境（绝对不要提交依赖安装目录）
.venv/
venv/
ENV/
env/

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# ruff
.ruff_cache/

# ---------- Node.js（前端可能后加）----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
.nuxt/
.next/
.output/
*.tsbuildinfo
test-results/
playwright-report/

# ---------- 环境变量 ----------
# ⚠️ .env 包含密钥和数据库密码，绝对不能提交
# .env.example 是模板，要保留在仓库中供新成员参考
.env
.env.local
.env.*.local
!.env.example

# ---------- 运行时产物：storage ----------
# 生成的图片/视频/成片体积大且含 API 产出，不进版本控制
# 保留目录结构占位符（.gitkeep），忽略实际内容
storage/projects/*
!storage/projects/.gitkeep
storage/assets/*
!storage/assets/.gitkeep
storage/renders/*
!storage/renders/.gitkeep
storage/exports/*
!storage/exports/.gitkeep

# ---------- 日志 ----------
logs/
*.log

# ---------- 数据库文件 ----------
*.sql.gz
*.sql.bz2
mysql_data/

# ---------- IDE / 编辑器 ----------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------- OS ----------
desktop.ini
ehthumbs.db

# ---------- Docker ----------
# docker-compose 生成的数据卷目录（如果挂载到项目内）
docker-data/

# ---------- Alembic ----------
# 迁移版本文件要提交，但 pycache 不要
migrations/__pycache__/
migrations/versions/__pycache__/

# ---------- 临时文件 ----------
*.tmp
*.bak
*.orig
